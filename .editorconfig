root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,mjs,js,ts,tsx,jsx,html,css}]
indent_size = 2

[*.md]
indent_size = 2
trim_trailing_whitespace = false

[*.{mq5,mqh}]
indent_size = 4
end_of_line = lf

[Makefile]
indent_style = tab
